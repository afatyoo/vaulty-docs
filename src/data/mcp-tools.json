            "type": "string",
            "description": "Tanggal YYYY-MM-DD. Kosong = hari ini."
          },
          "method": {
            "type": "string",
            "description": "Metode pembayaran. Kosong = metode pertama di daftar."
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "amount",
          "category",
          "name"
