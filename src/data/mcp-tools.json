    {
      "name": "add_transaction",
      "title": "Catat transaksi",
      "description": "Mencatat satu pemasukan atau pengeluaran. Butuh token dengan akses tulis. Cek list_categories dulu supaya kategori dan metode sesuai. Jumlah dalam mata uang pencatatan organisasi (lihat get_organization).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "income",
              "expense"
            ]
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Jumlah dalam mata uang pencatatan organisasi."
